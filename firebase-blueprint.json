{
  "entities": {
    "Exam": {
      "title": "Exam",
      "description": "Represents a CBT exam package distributed to a specific grade level (10, 11, 12, or SEMUA) and class.",
      "type": "object",
      "properties": {
        "id": {
          "type": "number",
          "description": "Numeric identifier of the exam."
        },
        "judul_ujian": {
          "type": "string",
          "description": "Title of the exam package.",
          "minLength": 1,
          "maxLength": 200
        },
        "durasi_menit": {
          "type": "number",
          "description": "Duration of the exam in minutes."
        },
        "target_tingkat": {
          "type": "string",
          "description": "Target grade level: 10, 11, 12, or SEMUA.",
          "enum": ["10", "11", "12", "SEMUA"],
          "maxLength": 16
        },
        "target_kelas": {
          "type": "string",
          "description": "Target specific class name or SEMUA.",
          "minLength": 1,
          "maxLength": 64
        },
        "acak_soal": {
          "type": "boolean",
          "description": "Whether question order is randomized per student."
        },
        "acak_opsi": {
          "type": "boolean",
          "description": "Whether option choices (A-E) are randomized per student."
        },
        "kode_paket": {
          "type": "string",
          "description": "Default package code for the exam (e.g. PAKET-A).",
          "maxLength": 32
        },
        "mode_multi_paket": {
          "type": "boolean",
          "description": "Whether students in a class/grade receive distinct question variants/packages."
        },
        "jumlah_paket": {
          "type": "number",
          "description": "Number of package variants (e.g. 2, 3, 4)."
        },
        "kategori_ujian": {
          "type": "string",
          "description": "Category or event type of the Sociology exam (e.g. PTS, PAS, Penilaian Harian).",
          "maxLength": 64
        },
        "status_ujian": {
          "type": "string",
          "description": "Lifecycle status of the exam: AKTIF, DRAF, or SELESAI.",
          "maxLength": 32
        },
        "target_rombel": {
          "type": "array",
          "description": "Optional list of specific class rombels that can access the exam."
        },
        "jadwal_mulai": {
          "type": "string",
          "description": "Optional start schedule timestamp.",
          "maxLength": 64
        },
        "jadwal_selesai": {
          "type": "string",
          "description": "Optional end schedule timestamp.",
          "maxLength": 64
        },
        "token_sesi": {
          "type": "string",
          "description": "Dynamic exam session token configured by the teacher.",
          "maxLength": 20
        },
        "tampilkan_nilai": {
          "type": "boolean",
          "description": "Whether students can view their score immediately after completing the exam."
        },
        "pengumuman": {
          "type": "string",
          "description": "Announcement shown on the student dashboard.",
          "maxLength": 600
        },
        "mata_pelajaran": {
          "type": "string",
          "description": "Subject name for multi-subject CBT exams (e.g. Sosiologi, Ekonomi, Sejarah).",
          "maxLength": 80
        },
        "distribusi_paket_mode": {
          "type": "string",
          "description": "Distribution mode for exam packages (OTOMATIS_GANJIL_GENAP, KHUSUS_GANJIL, KHUSUS_GENAP, MANUAL_SISWA).",
          "maxLength": 40
        },
        "target_siswa_ids": {
          "type": "array",
          "description": "Optional list of specific student IDs assigned to receive this exam package."
        },
        "isDeleted": {
          "type": "boolean",
          "description": "Soft-delete flag marking exam as archived pending 30-day TTL purge."
        },
        "deletedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when exam was soft-deleted.",
          "maxLength": 64
        },
        "purgeAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp scheduled for permanent deletion (deletedAt + 30 days).",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of last synchronization.",
          "maxLength": 64
        }
      },
      "required": ["id", "judul_ujian", "durasi_menit", "target_tingkat", "target_kelas", "updatedAt"]
    },
    "Student": {
      "title": "Student",
      "description": "Represents a student registered in the CBT database with a unique 6-character exam token.",
      "type": "object",
      "properties": {
        "id": {
          "type": "number",
          "description": "Numeric identifier of the student."
        },
        "nama": {
          "type": "string",
          "description": "Full name of the student.",
          "minLength": 1,
          "maxLength": 150
        },
        "kelas": {
          "type": "string",
          "description": "Class/rombel of the student (e.g. X MIPA 1, XI IPS 1, XII MIPA 2).",
          "minLength": 1,
          "maxLength": 64
        },
        "token_ujian": {
          "type": "string",
          "description": "Unique 6-character alphanumeric exam token.",
          "minLength": 6,
          "maxLength": 6,
          "pattern": "^[A-Z0-9]{6}$"
        },
        "status_ujian": {
          "type": "string",
          "description": "Current exam status of the student.",
          "enum": ["Belum Mulai", "Sedang Ujian", "Selesai", "Diblokir"],
          "maxLength": 32
        },
        "kode_soal": {
          "type": "string",
          "description": "Assigned package code for the student (e.g. PAKET-A, PAKET-B).",
          "maxLength": 32
        },
        "variasi_paket": {
          "type": "string",
          "description": "Package variant letter (e.g. A, B, C).",
          "maxLength": 8
        },
        "nisn": {
          "type": "string",
          "description": "Student National Identification Number (NISN).",
          "maxLength": 40
        },
        "password_login": {
          "type": "string",
          "description": "Custom account login password/token set by the student.",
          "maxLength": 40
        },
        "live_telemetry": {
          "type": "object",
          "description": "Real-time student web activity, current question, fullscreen/focus state, and anti-inspect element telemetry."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of last synchronization.",
          "maxLength": 64
        }
      },
      "required": ["id", "nama", "kelas", "token_ujian", "status_ujian", "updatedAt"]
    },
    "Question": {
      "title": "Question",
      "description": "Represents a CBT question (PG Biasa or PG Kompleks) belonging to an exam package.",
      "type": "object",
      "properties": {
        "id": {
          "type": "number",
          "description": "Numeric identifier of the question."
        },
        "exam_id": {
          "type": "number",
          "description": "Foreign key ID of the parent exam package."
        },
        "teks_soal": {
          "type": "string",
          "description": "Main question text.",
          "minLength": 1,
          "maxLength": 4000
        },
        "tipe_soal": {
          "type": "string",
          "description": "Question type: PG or Kompleks.",
          "enum": ["PG", "Kompleks"],
          "maxLength": 20
        },
        "data_opsi": {
          "type": "object",
          "description": "Option map A-E and optional stimulus wacana."
        },
        "kunci_jawaban": {
          "type": "array",
          "description": "Array of correct option keys (A-E)."
        },
        "bobot": {
          "type": "number",
          "description": "Maximum point weight for the question."
        },
        "version": {
          "type": "number",
          "description": "Immutable question version number."
        },
        "parent_question_id": {
          "type": "number",
          "description": "ID of previous question version when edited during active/historical exam."
        },
        "is_archived_version": {
          "type": "boolean",
          "description": "True when superseded by a newer version while preserved for historical scoring."
        },
        "archived_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when this version was superseded.",
          "maxLength": 64
        },
        "version_label": {
          "type": "string",
          "description": "Human readable version tag such as soal_v2.",
          "maxLength": 32
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of last synchronization.",
          "maxLength": 64
        }
      },
      "required": ["id", "exam_id", "teks_soal", "tipe_soal", "data_opsi", "kunci_jawaban", "bobot", "updatedAt"]
    },
    "Result": {
      "title": "Result",
      "description": "Represents a student's submitted exam score, answers, anti-cheat tab logs, and Gemini AI evaluation.",
      "type": "object",
      "properties": {
        "id": {
          "type": "number",
          "description": "Numeric identifier of the exam result."
        },
        "student_id": {
          "type": "number",
          "description": "Numeric identifier of the student."
        },
        "exam_id": {
          "type": "number",
          "description": "Numeric identifier of the exam."
        },
        "skor_angka": {
          "type": "number",
          "description": "Normalized score (0-100)."
        },
        "jawaban_siswa": {
          "type": "object",
          "description": "Map of questionId to selected option keys."
        },
        "analisis_ai": {
          "type": "object",
          "description": "Optional AI cognitive evaluation result."
        },
        "pelanggaran_tab": {
          "type": "number",
          "description": "Number of tab switch violations detected during the exam."
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Submission timestamp.",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of last synchronization.",
          "maxLength": 64
        }
      },
      "required": ["id", "student_id", "exam_id", "skor_angka", "jawaban_siswa", "pelanggaran_tab", "created_at", "updatedAt"]
    },
    "CbtSyncPulse": {
      "title": "CbtSyncPulse",
      "description": "Real-time synchronization state document broadcasting changes across teacher and student portals.",
      "type": "object",
      "properties": {
        "lastSyncedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of the latest synchronization event.",
          "minLength": 1,
          "maxLength": 64
        },
        "lastEvent": {
          "type": "string",
          "description": "Description of the latest CBT synchronization event.",
          "minLength": 1,
          "maxLength": 200
        },
        "totalExams": {
          "type": "number",
          "description": "Total active exam packages."
        },
        "totalStudents": {
          "type": "number",
          "description": "Total registered students."
        },
        "totalQuestions": {
          "type": "number",
          "description": "Total questions in bank."
        },
        "totalResults": {
          "type": "number",
          "description": "Total submitted exam results."
        }
      },
      "required": ["lastSyncedAt", "lastEvent", "totalExams", "totalStudents", "totalQuestions", "totalResults"]
    },
    "LiveSession": {
      "title": "LiveSession",
      "description": "Singleton aggregated live monitoring document per active exam session for 1-read supervisor listening.",
      "type": "object",
      "properties": {
        "exam_id": {
          "type": "number",
          "description": "Exam package ID."
        },
        "judul_ujian": {
          "type": "string",
          "description": "Exam title.",
          "maxLength": 200
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of latest participant update.",
          "maxLength": 64
        },
        "activeCount": {
          "type": "number",
          "description": "Count of active exam takers."
        },
        "finishedCount": {
          "type": "number",
          "description": "Count of finished exam takers."
        },
        "blockedCount": {
          "type": "number",
          "description": "Count of blocked exam takers."
        },
        "notStartedCount": {
          "type": "number",
          "description": "Count of registered students not yet started."
        },
        "totalViolations": {
          "type": "number",
          "description": "Aggregated anti-cheat violations."
        },
        "participants": {
          "type": "object",
          "description": "Map of studentId string to LiveSessionParticipant summary."
        }
      },
      "required": ["exam_id", "updatedAt"]
    },
    "ExamArchive": {
      "title": "ExamArchive",
      "description": "30-day soft-deleted exam archive snapshot with TTL expiration before permanent cleanup.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Archive document identifier.",
          "maxLength": 128
        },
        "exam_id": {
          "type": "number",
          "description": "Archived exam ID."
        },
        "judul_ujian": {
          "type": "string",
          "description": "Archived exam title.",
          "maxLength": 200
        },
        "exam_data": {
          "type": "object",
          "description": "Full snapshot of archived ExamItem."
        },
        "questions_data": {
          "type": "array",
          "description": "Snapshot of archived exam questions."
        },
        "results_data": {
          "type": "array",
          "description": "Snapshot of archived exam results."
        },
        "deletedBy": {
          "type": "string",
          "description": "Admin identifier who deleted the exam.",
          "maxLength": 120
        },
        "deletedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when soft-deleted.",
          "maxLength": 64
        },
        "purgeAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp scheduled for permanent deletion.",
          "maxLength": 64
        },
        "expireAt": {
          "type": "string",
          "format": "date-time",
          "description": "Firestore TTL policy field (+30 days).",
          "maxLength": 64
        },
        "restoredAt": {
          "type": "string",
          "format": "date-time",
          "description": "Optional ISO timestamp if restored.",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of last update.",
          "maxLength": 64
        }
      },
      "required": ["id", "exam_id", "judul_ujian", "deletedAt", "purgeAt", "expireAt", "updatedAt"]
    }
  },
  "firestore": {
    "/exams/{examId}": {
      "schema": { "$ref": "#/entities/Exam" },
      "description": "Synchronized CBT exam packages and 3-grade class distributions."
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Synchronized CBT student records and 6-character exam tokens."
    },
    "/questions/{questionId}": {
      "schema": { "$ref": "#/entities/Question" },
      "description": "Synchronized CBT question bank items."
    },
    "/results/{resultId}": {
      "schema": { "$ref": "#/entities/Result" },
      "description": "Synchronized CBT student exam results and AI evaluations."
    },
    "/cbt_sync/{syncId}": {
      "schema": { "$ref": "#/entities/CbtSyncPulse" },
      "description": "Real-time synchronization pulse document for live cross-client updates."
    },
    "/live_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/LiveSession" },
      "description": "Aggregated singleton live session state per exam for 1-read proctor monitoring."
    },
    "/exams_archive/{archiveId}": {
      "schema": { "$ref": "#/entities/ExamArchive" },
      "description": "30-day soft-deleted exam snapshots for audit recovery prior to TTL purge."
    }
  }
}
